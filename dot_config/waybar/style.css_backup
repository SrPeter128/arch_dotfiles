* {
    font-family: "NotoSansMono", sans-serif;
    font-size: 13px;
}

window#waybar {
    background-color: rgba(30, 30, 46, 0.8);
    color: #cdd6f4;
    border-radius: 10px;
    margin: 10px;
    padding: 5px 10px;
}

#workspaces button {
    padding: 0 5px;
    color: #a6adc8;
}

#workspaces button.active {
    color: #f38ba8;
}

#clock, #battery, #network, #pulseaudio, #tray {
    margin: 0 8px;
}

